export default {
  async fetch(request) {
    if (request.method !== "POST") {
      return Response.json({ error: "Method not allowed" }, { status: 405 });
    }

    const apiKey = process.env.GEMINI_API_KEY;
    if (!apiKey) {
      return Response.json({ error: "API 키가 아직 연결되지 않았습니다." }, { status: 500 });
    }

    try {
      const { history } = await request.json();

      if (!Array.isArray(history) || history.length === 0) {
        return Response.json({ error: "질문 내용이 비어 있습니다." }, { status: 400 });
      }

      const response = await fetch(
        "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "x-goog-api-key": apiKey,
          },
          body: JSON.stringify({
            systemInstruction: {
              parts: [
                {
                  text: "너의 이름은 'Vex Bot'이야. 사용자가 직접 만든 똑똑하고 친절한 AI 웹 어시스턴트야. 항상 한국어로 명확하게 답변하고, 코딩이나 아이디어 질문이 들어오면 이해하기 쉽게 도와줘."
                }
              ]
            },
            contents: history,
          }),
        }
      );

      const data = await response.json();

      if (!response.ok) {
        return Response.json(
          { error: data?.error?.message || "AI 응답 중 오류가 발생했습니다." },
          { status: response.status }
        );
      }

      const reply =
        data?.candidates?.[0]?.content?.parts?.[0]?.text ||
        "답변을 생성하지 못했어요. 다시 시도해 주세요.";

      return Response.json({ reply }, { status: 200 });
    } catch (err) {
      return Response.json({ error: "서버 오류: " + err.message }, { status: 500 });
    }
  },
};
